Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
# Permanent entry point for portfolio and external links, updated with each release.
RewriteRule ^downloads/ubuntu/?$ /downloads/franok_0.2.0_amd64.deb [R=302,L]
# The stable site URL uses GitHub's release CDN for large downloads.
# The same checksum-verified file remains on the origin as a second source.
RewriteCond %{QUERY_STRING} !(^|&)mirror=origin(&|$) [NC]
RewriteRule ^downloads/franok_0\.2\.0_amd64\.deb$ https://github.com/yunusemrejr/Franok/releases/download/v0.2.0/franok_0.2.0_amd64.deb [R=302,L,QSD]
</IfModule>
AddType application/wasm .wasm
AddType text/javascript .mjs
AddType text/vtt .vtt
AddType video/mp4 .mp4
AddType font/woff2 .woff2
AddType application/vnd.debian.binary-package .deb
<IfModule mod_headers.c>
Header always set X-Content-Type-Options nosniff
Header always set Referrer-Policy strict-origin-when-cross-origin
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
<FilesMatch "^(index\.html|revision\.txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
